{
  "name": "majik-buwiz-desktop",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "update": "npm install @majikah/majik-file@latest @majikah/majik-signature@latest @thezelijah/majik-user@latest @majikah/majik-invoice@latest @majikah/majik-universal-id@latest",
    "build": "tsc && vite build && npm run update",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run update && tauri build",
    "stage:exe": "copy src-tauri\\target\\release\\majik-buwiz-desktop.exe dist\\msix-staging\\",
    "stage:assets": "robocopy msix\\Assets dist\\msix-staging\\Assets /E || exit 0",
    "stage:manifest": "copy msix\\AppxManifest.xml dist\\msix-staging\\",
    "stage": "mkdir .\\dist\\msix-staging  && npm run stage:exe && npm run stage:assets && npm run stage:manifest",
    "package:msix": "npx winapp pack .\\dist\\msix-staging --cert .\\devcert.pfx --output .\\dist\\majik-buwiz.0.1.2_x64.msix",
    "package": "npm run tauri:build && npm run stage && npm run package:msix",
    "generate:icons:appx": "npx tsx scripts/generate-icons.ts",
    "generate:icons:tauri": "npx tauri icon ./icon.png",
    "generate:icons": "npm run generate:icons:appx && npm run generate:icons:tauri"
  },
  "dependencies": {
